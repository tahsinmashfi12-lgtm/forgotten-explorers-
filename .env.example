# Forgotten Explorers — environment variables
# Copy to .env.local for local development (never commit real values).
# On Vercel: Project → Settings → Environment Variables.

# Required for NOVA AI mode and the AI translation buttons.
# Without it the site still works fully in offline "archive mode".
# Create a key at https://console.anthropic.com/ — keep it secret, server-side only.
ANTHROPIC_API_KEY=

# Optional: Claude model used by /api/claude (default: claude-sonnet-5-5)
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: set to false to switch AI off without removing the key (default: true)
AI_ENABLED=true

# Optional: comma-separated list of site origins allowed to call /api/claude.
# Strongly recommended in production, e.g. https://forgotten-explorers.vercel.app
ALLOWED_ORIGINS=

# Optional: best-effort per-instance request limit per visitor IP (default: 20)
RATE_LIMIT_PER_MINUTE=20

# Optional: upper bound for output tokens per AI call (default: 4000)
MAX_OUTPUT_TOKENS=4000
